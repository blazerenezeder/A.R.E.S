# A.R.E.S. Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit .env to GitHub — it contains secrets.

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# API key from console.anthropic.com. A.R.E.S. also routes agent calls through
# OpenClaw's gateway; this key is a fallback / for direct SDK calls.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Slack (four pilot bots) ─────────────────────────────────────────────────
# One bot token + app token per pilot. Legacy variable names retained so
# existing .env files keep working — values are the current pilots.
SLACK_TOKEN_GRIZZ=xoxb-...        # Maverick
SLACK_TOKEN_ICE_BEAR=xoxb-...     # Goose
SLACK_TOKEN_PANDA=xoxb-...        # Bob
SLACK_TOKEN_TABES=xoxb-...        # Rooster
SLACK_APP_TOKEN_GRIZZ=xapp-...
SLACK_APP_TOKEN_ICE_BEAR=xapp-...
SLACK_APP_TOKEN_PANDA=xapp-...
SLACK_APP_TOKEN_TABES=xapp-...
BLAZE_SLACK_ID=UXXXXXXXXXX
FLIGHT_DECK_CHANNEL=flight-deck

# ── Job hunt enrichment ─────────────────────────────────────────────────────
HUNTER_API_KEY=your_hunter_api_key

# ── Candidate profile (used to generate cover letters + fill forms) ─────────
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=you@example.com
CANDIDATE_PHONE=555-555-5555
CANDIDATE_ADDRESS=
CANDIDATE_CITY=San Francisco
CANDIDATE_STATE=CA
CANDIDATE_ZIP=
CANDIDATE_LINKEDIN=https://linkedin.com/in/you
CANDIDATE_RESUME=/absolute/path/to/your/resume.pdf
CANDIDATE_SALARY_MIN=0
CANDIDATE_SALARY_FLOOR=0

# ── Texting Blaze (Twilio SMS) ──────────────────────────────────────────────
# A.R.E.S. sends briefs and takes YES / NO / CL / SCAN and normal chat by text.
# From console.twilio.com. Texts deliver once A2P 10DLC registration is approved.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                      # your Twilio number, e.g. +14155550000
MY_PHONE=                         # your phone, e.g. +14155551234

# Optional: iMessage instead (needs a separate Apple ID on this Mac; see imessage.py)
ARES_IMESSAGE_TO=

# Optional, legacy: Telegram (only used if a bot token is set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: daemon runs the daily scan itself (leave unset if launchd does it)
ARES_SCAN_TIME=                   # e.g. 07:00

# Optional: also mirror A.R.E.S. messages to a Slack channel (off by default)
ARES_ENABLE_SLACK=0
ARES_SLACK_TOKEN=

# ── LinkedIn network ────────────────────────────────────────────────────────
# LinkedIn → Settings → Data privacy → Get a copy of your data → Connections.
# Save the file as linkedin_connections.csv in this folder (gitignored).
LINKEDIN_CONNECTIONS_CSV=
